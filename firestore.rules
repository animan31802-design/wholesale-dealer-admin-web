rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getUserRole() {
      return getUserData().role;
    }

    function isAdmin() {
      return isLoggedIn() && getUserRole() == 'admin';
    }

    function isPackingStaff() {
      return isLoggedIn() && getUserRole() == 'packing_staff';
    }

    function isFieldAgent() {
      return isLoggedIn() && getUserRole() == 'field_agent';
    }

    function isDelivery() {
      return isLoggedIn() && getUserRole() == 'delivery';
    }

    function isAdminOrPacking() {
      return isAdmin() || isPackingStaff();
    }

    // ── Users ────────────────────────────────────────────────────
    // FIX (HIGH): Users can only read their own doc; admins read all.
    // Prevents delivery/packing staff from reading other users' PII.
    match /users/{userId} {
      allow read:   if isLoggedIn() && (request.auth.uid == userId || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // ── Regions ──────────────────────────────────────────────────
    match /regions/{regionId} {
      allow read:                   if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Products ─────────────────────────────────────────────────
    // FIX (HIGH): Field agents may only touch reservedStock.
    match /products/{productId} {
      allow read:   if isLoggedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (isFieldAgent()
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['reservedStock']));

      // stockMovements subcollection
      match /stockMovements/{moveId} {
        allow read:  if isAdmin() || isPackingStaff();
        allow write: if isAdmin();
      }
    }

    // ── Customers ────────────────────────────────────────────────
    // FIX (HIGH): Scoped by role.
    match /customers/{customerId} {
      allow read:   if isAdmin() || isPackingStaff() || isFieldAgent();
      allow create: if isAdmin() || isFieldAgent();
      // Admin: full update. Field agent: only outstandingDue (updated during order transaction).
      allow update: if isAdmin()
        || (isFieldAgent()
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['outstandingDue']));
      allow delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────
    // FIX (HIGH): Reads scoped by role.
    // FIX (MEDIUM): Field-level restrictions for packing staff and delivery.
    // FIX (HIGH): Packing staff cancel bug — restrict allowed keys strictly.
    match /orders/{orderId} {
      allow read: if isAdmin()
        || isPackingStaff()
        || (isFieldAgent()  && resource.data.agentId         == request.auth.uid)
        || (isDelivery()    && resource.data.deliveryPersonId == request.auth.uid);

      allow create: if isAdmin() || isFieldAgent();

      // Admin: unrestricted update.
      // Packing staff: may ONLY flip pending→packed and set packing fields (no cancel).
      // Delivery: may ONLY update delivery-specific fields on their assigned orders.
      allow update: if isAdmin()
        || (isPackingStaff()
            && resource.data.status == 'pending'
            && request.resource.data.status == 'packed'
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly(['status', 'packedAt', 'packedBy', 'packedByName']))
        || (isDelivery()
            && resource.data.deliveryPersonId == request.auth.uid
            && request.resource.data.diff(resource.data)
                .affectedKeys()
                .hasOnly([
                  'status', 'amountCollected', 'paymentMode',
                  'deliveredAt', 'signatureUrl', 'signature',
                  'signatureCollected', 'billWithAgent'
                ]));

      allow delete: if isAdmin();
    }

    // ── Settings ─────────────────────────────────────────────────
    // FIX (HIGH): invoiceCounter write must be allowed for packing staff too
    // (they generate invoices). Split into two rules:
    //   - business doc: admin write only.
    //   - invoiceCounter: admin + packing staff write (invoice generation).
    // All logged-in users still need READ for invoice/business info display.
    match /settings/business {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }

    match /settings/invoiceCounter {
      allow read:  if isLoggedIn();
      allow write: if isAdmin() || isPackingStaff();
    }

    // Catch-all for any other settings docs — admin only
    match /settings/{docId} {
      allow read:  if isLoggedIn();
      allow write: if isAdmin();
    }
  }
}
