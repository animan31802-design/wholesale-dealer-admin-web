rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isLoggedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isLoggedIn() && getUserRole() == 'admin';
    }

    function isPackingStaff() {
      return isLoggedIn() && getUserRole() == 'packing_staff';
    }

    function isFieldAgent() {
      return isLoggedIn() && getUserRole() == 'field_agent';
    }

    function isDelivery() {
      return isLoggedIn() && getUserRole() == 'delivery';
    }

    function isAdminOrPacking() {
      return isAdmin() || isPackingStaff();
    }

    // ── Users ────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:             if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Regions ──────────────────────────────────────────────────
    match /regions/{regionId} {
      allow read:                   if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Products ─────────────────────────────────────────────────
    match /products/{productId} {
      allow read:             if isLoggedIn();
      // Admin manages products; field agent updates reservedStock during order transaction
      allow create, delete:   if isAdmin();
      allow update:           if isAdmin() || isFieldAgent();
    }

    // ── Customers ────────────────────────────────────────────────
    match /customers/{customerId} {
      allow read:                   if isLoggedIn();
      allow create, update, delete: if isAdmin();
    }

    // ── Orders ───────────────────────────────────────────────────
    match /orders/{orderId} {
      allow read:   if isLoggedIn();
      // Field agent creates; admin or packing staff updates status to packed
      allow create: if isAdmin() || isFieldAgent();
      allow update: if isAdmin() || isAdminOrPacking() || isDelivery();
      allow delete: if isAdmin();
    }

    // ── Settings ─────────────────────────────────────────────────
    // Admin reads/writes all settings
    // All logged-in users can READ settings (needed for invoice generation)
    match /settings/{docId} {
      allow read:          if isLoggedIn();
      allow write:         if isAdmin();
    }
  }
}
